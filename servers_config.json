{
  "mcpServers": {
    "local-dev": {
      "command": "python",
      "args": ["mcp_server.py"],
      "env": {}
    },
    "time": {
      "command": "uvx",
      "args": ["mcp-server-time", "--local-timezone=Asia/Kolkata"]
    },
    "fetch": {
      "args": ["mcp-server-fetch"],
      "command": "uvx"
    }
  }
}
