# ArcBot reads settings from ~/.config/arcbot/, not from this file — the app's
# setup wizard writes them for you. These variables are here for containers, CI
# and anyone who prefers to inject credentials from the environment.
#
# An environment variable always wins over a key saved in ArcBot.

# --- Model credentials (only what you actually use) -----------------------
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
# Key for the "Custom endpoint" provider, if your server needs one.
ARCBOT_API_KEY=

# --- Local model servers --------------------------------------------------
# Override the defaults if your server is not on the usual port.
ARCBOT_LMSTUDIO_URL=http://localhost:1234/v1
ARCBOT_OLLAMA_URL=http://localhost:11434/v1

# --- Paths ----------------------------------------------------------------
# ARCBOT_CONFIG_DIR=~/.config/arcbot
# ARCBOT_DATA_DIR=~/.local/share/arcbot

# --- Logging --------------------------------------------------------------
# DEBUG | INFO | WARNING | ERROR
ARCBOT_LOG_LEVEL=INFO
